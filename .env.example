# Skopíruj ako .env.local a doplň hodnoty zo Supabase (Project Settings → API).
# .env.local sa NIKDY necommituje (je v .gitignore).

# URL projektu, napr. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_…). Pri starších projektoch použi "anon" kľúč
# v premennej NEXT_PUBLIC_SUPABASE_ANON_KEY – aplikácia berie ktorýkoľvek z nich.
# Je to verejný kľúč určený pre klienta; práva dáva až RLS v databáze.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role / secret key aplikácia NEPOUŽÍVA a nikdy ho sem nedávaj.
